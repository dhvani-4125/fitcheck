# Copy to .env.local for local development with cloud sync.
# Find both values in Supabase → Project Settings → API.
# The anon key is meant to be public; row-level security in supabase/schema.sql protects each user's data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
